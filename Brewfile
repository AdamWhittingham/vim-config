# Search tools
brew "fd"
brew "ripgrep"

# Treesitter
brew "tree-sitter"
brew "tree-sitter-cli"

# Language servers
# Installed via Homebrew rather than asdf so they work regardless of the
# Node/Go version a project pins
brew "ansible-language-server"
brew "bash-language-server"
brew "docker-language-server" # Compose files
brew "dockerfile-language-server" # Dockerfiles (works without Docker installed)
brew "gopls"
brew "lua-language-server"
brew "vtsls" # TypeScript & JavaScript
brew "vscode-langservers-extracted" # jsonls & eslint
brew "yaml-language-server"

# Linters & formatters used by the language servers
brew "ansible-lint"
brew "hadolint"
brew "shellcheck"
brew "shfmt"
